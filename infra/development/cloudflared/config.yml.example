# `just tunnel-setup` copies this template to `.state/cloudflared/config.yml`
# in the current worktree and replaces the hostname placeholder. The execution
# credential at `.state/cloudflared/credentials.json` is the single source of
# truth for TunnelID, so this route-only config does not duplicate identity.

ingress:
  - hostname: "*.example.com"
    service: http://127.0.0.1:80
  - service: http_status:404
