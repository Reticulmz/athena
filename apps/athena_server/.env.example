# Required server services
DATABASE_URL=postgresql://localhost:5432/athena
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
VALKEY_URL=redis://localhost:6379
BEATMAP_METADATA_FETCH_MAX_CONCURRENCY=4

# Runtime
ENVIRONMENT=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DOMAIN=athena.localhost

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_FILES=30

# Blob storage
BLOB_STORAGE_BACKEND=local
BLOB_STORAGE_LOCAL_ROOT=.data/blobs

# Beatmap mirror
BEATMAP_OFFICIAL_SOURCES_ENABLED=false
BEATMAP_MIRROR_TRUST_POLICY=untrusted
BEATMAP_OSU_CURRENT_URL_TEMPLATE=https://osu.ppy.sh/osu/{beatmap_id}
BEATMAP_OSU_LEGACY_URL_TEMPLATE=https://old.ppy.sh/osu/{beatmap_id}

# osu!direct
OSU_DIRECT_SEARCH_BACKEND=auto
OSU_DIRECT_EXTERNAL_INDEX_BACKEND=disabled
OSU_DIRECT_MEILISEARCH_URL=
OSU_DIRECT_MEILISEARCH_ACCESS_KEY=
OSU_DIRECT_MEILISEARCH_INDEX_NAME=athena_osu_direct_beatmapsets
OSU_DIRECT_UPSTREAM_SEARCH_ENABLED=true
OSU_DIRECT_UPSTREAM_SEARCH_PROVIDERS=hinamizawa,nerinyan
OSU_DIRECT_UPSTREAM_SEARCH_WAIT_SECONDS=5
OSU_DIRECT_UPSTREAM_SEARCH_FIRST_PAGE_REFRESH_SECONDS=300
OSU_DIRECT_HINAMIZAWA_SEARCH_URL=https://mirror.hinamizawa.ai/api/v1/hinai/search
OSU_DIRECT_NERINYAN_SEARCH_URL=https://api.nerinyan.moe/v2/search

# Optional: required only when official sources are enabled in development or production
BEATMAP_OFFICIAL_API_CLIENT_ID=
BEATMAP_OFFICIAL_API_CLIENT_SECRET=
BEATMAP_COMMUNITY_MIRROR_URL_TEMPLATES=
