nginx.dev.conf
cloudflared/config.yml
certs/

# Environment variables
.env
.env.*
!.env.example
!apps/athena_server/.env.example

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml

# IDE / editor local settings
.idea/
.vscode/

# Local agent/tool runtime state (configuration directories are not ignored)
.rtk/
.serena/
.antigravitycli/

# Application logs
logs/
*.log

.playwright-mcp/
.data/*
apps/athena_server/.data

# Temporary files
tmp/*
