# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Test / lint / coverage caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv

# Nix / flake
result

# Worktree-local generated state, credentials, certificates, and actual ingress config
.state/

